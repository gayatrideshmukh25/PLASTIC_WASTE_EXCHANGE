# --- Development -------------------------------------------------------------
# Where `npm run dev` proxies /api/* to (your existing Express server).
BACKEND_URL=http://localhost:3000

# --- Production --------------------------------------------------------------
# Leave empty if the built app is served from the same origin as the API.
# Otherwise set the API's public URL (the API must then allow CORS with credentials).
VITE_API_URL=  http://localhost:5173/

